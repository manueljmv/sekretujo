<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sekretujo.App.ViewModels"
             x:Class="Sekretujo.App.Views.EntryDetailView"
             x:DataType="vm:EntryDetailViewModel">
  <StackPanel Spacing="8">
    <TextBox PlaceholderText="Título" Text="{Binding Title}" />
    <CheckBox Content="Favorito" IsChecked="{Binding IsFavorite}" />
    <StackPanel IsVisible="{Binding !IsNote}" Spacing="8">
      <TextBox PlaceholderText="Usuario" Text="{Binding Username}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBox PlaceholderText="Password" Text="{Binding Password}" Width="240" />
        <Button Content="Generar" Command="{Binding GeneratePasswordCommand}" />
        <Button Content="Copiar" Command="{Binding CopyPasswordCommand}" />
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Longitud:" VerticalAlignment="Center" />
        <NumericUpDown Value="{Binding GeneratorLength}" Minimum="4" Maximum="128" Width="110" />
        <CheckBox Content="Mayúsculas" IsChecked="{Binding GeneratorUseUppercase}" />
        <CheckBox Content="Minúsculas" IsChecked="{Binding GeneratorUseLowercase}" />
        <CheckBox Content="Dígitos" IsChecked="{Binding GeneratorUseDigits}" />
        <CheckBox Content="Símbolos" IsChecked="{Binding GeneratorUseSymbols}" />
      </StackPanel>
      <TextBox PlaceholderText="URL" Text="{Binding Url}" />
      <TextBox PlaceholderText="Notas" Text="{Binding Notes}" AcceptsReturn="True" Height="80" />
      <TextBox PlaceholderText="Secreto TOTP (Base32)" Text="{Binding TotpSecret}" />
      <StackPanel Orientation="Horizontal" Spacing="8">
        <TextBlock Text="{Binding TotpCodeDisplay}" />
        <TextBlock Text="{Binding TotpErrorMessage}" Foreground="Red" />
        <Button Content="Copiar TOTP" Command="{Binding CopyTotpCommand}" />
      </StackPanel>
    </StackPanel>
    <TextBox IsVisible="{Binding IsNote}" PlaceholderText="Contenido" Text="{Binding Body}"
             AcceptsReturn="True" Height="200" />
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding !IsConfirmingDelete}">
      <Button Content="Guardar" Command="{Binding SaveCommand}" />
      <Button Content="Eliminar" Command="{Binding DeleteCommand}" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsConfirmingDelete}">
      <TextBlock Text="¿Eliminar esta entrada?" VerticalAlignment="Center" />
      <Button Content="Sí" Command="{Binding ConfirmDeleteCommand}" />
      <Button Content="No" Command="{Binding CancelDeleteCommand}" />
    </StackPanel>
  </StackPanel>
</UserControl>
