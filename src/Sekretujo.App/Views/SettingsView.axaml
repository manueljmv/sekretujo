<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sekretujo.App.ViewModels"
             x:Class="Sekretujo.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">
  <Border Classes="card" Width="380">
  <StackPanel Spacing="10">
    <TextBlock Text="Ajustes" FontSize="20" FontWeight="Bold" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Auto-lock (min):" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding AutoLockMinutes}" Minimum="1" Maximum="120" />
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBlock Text="Limpiar portapapeles (s):" VerticalAlignment="Center" />
      <NumericUpDown Value="{Binding ClipboardClearSeconds}" Minimum="5" Maximum="300" />
    </StackPanel>
    <Button Content="Aplicar" Command="{Binding ApplyTimeoutsCommand}" />
    <Separator Margin="0,8" />
    <TextBox PlaceholderText="Ruta de archivo CSV/JSON" Text="{Binding FilePath}" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Command="{Binding ExportCsvCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="icon" Width="14" Height="14">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/export.png" Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
          <TextBlock Text="Exportar CSV" />
        </StackPanel>
      </Button>
      <Button Command="{Binding ImportCsvCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="icon" Width="14" Height="14">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/import.png" Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
          <TextBlock Text="Importar CSV" />
        </StackPanel>
      </Button>
    </StackPanel>
    <StackPanel Orientation="Horizontal" Spacing="8">
      <Button Command="{Binding ImportBitwardenCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="icon" Width="14" Height="14">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/import.png" Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
          <TextBlock Text="Importar Bitwarden" />
        </StackPanel>
      </Button>
      <Button Command="{Binding ImportKeePassCommand}">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Border Classes="icon" Width="14" Height="14">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/import.png" Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
          <TextBlock Text="Importar KeePass" />
        </StackPanel>
      </Button>
    </StackPanel>
    <TextBlock Text="{Binding StatusMessage}" />
    <Button Content="Cerrar" Command="{Binding CloseCommand}" />
  </StackPanel>
  </Border>
</UserControl>
