<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sekretujo.App.ViewModels"
             x:Class="Sekretujo.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">
  <StackPanel Spacing="12" Width="360" HorizontalAlignment="Center" VerticalAlignment="Center">
    <TextBlock Text="Sekretujo" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
    <StackPanel Orientation="Horizontal" Spacing="8">
      <TextBox PlaceholderText="Ruta del archivo .vault" Text="{Binding VaultPath}" Width="230" />
      <Button Content="Abrir..." Click="OnBrowseOpenClicked" />
      <Button Content="Nuevo..." Click="OnBrowseSaveClicked" />
    </StackPanel>
    <TextBox PlaceholderText="Master password" PasswordChar="•" Text="{Binding MasterPassword}" />
    <Grid ColumnDefinitions="*,Auto">
      <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="8" VerticalAlignment="Center"
                   Value="{Binding MasterPasswordStrengthValue}"
                   Foreground="{Binding MasterPasswordStrengthColor}" />
      <TextBlock Grid.Column="1" Margin="8,0,0,0" Text="{Binding MasterPasswordStrengthLabel}" />
    </Grid>
    <TextBlock Text="{Binding ErrorMessage}" Foreground="Red" />
  </StackPanel>
</UserControl>
