<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sekretujo.App.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Sekretujo.App.Views.UnlockView"
             x:DataType="vm:UnlockViewModel">
  <Grid RowDefinitions="*,Auto,Auto" HorizontalAlignment="Center" VerticalAlignment="Center">
    <Border Grid.Row="0" Classes="card" Width="400" Padding="32">
      <StackPanel Spacing="14">
        <Border Width="56" Height="56" CornerRadius="14" Background="{DynamicResource BrushAccentMuted}"
                HorizontalAlignment="Center">
          <Border Classes="icon" Width="24" Height="24" Background="{DynamicResource BrushAccent}">
            <Border.OpacityMask>
              <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/lock.png" Stretch="Uniform" />
            </Border.OpacityMask>
          </Border>
        </Border>
        <TextBlock Text="Sekretujo" Classes="heading" HorizontalAlignment="Center" />
        <TextBlock Text="Tu bóveda local, cifrada en este equipo" Classes="muted"
                   HorizontalAlignment="Center" Margin="0,0,0,8" />

        <TextBlock Text="BÓVEDA" Classes="eyebrow" />
        <Grid ColumnDefinitions="*,Auto,Auto">
          <TextBox Grid.Column="0" PlaceholderText="Ruta del archivo .vault" Text="{Binding VaultPath}"
                    Margin="0,0,8,0" />
          <Button Grid.Column="1" Content="Abrir..." Click="OnBrowseOpenClicked" Margin="0,0,8,0" />
          <Button Grid.Column="2" Content="Nuevo..." Click="OnBrowseSaveClicked" />
        </Grid>

        <TextBlock Text="MASTER PASSWORD" Classes="eyebrow" Margin="0,8,0,0" />
        <Grid>
          <TextBox PlaceholderText="Master password" PasswordChar="•" Text="{Binding MasterPassword}"
                    RevealPassword="{Binding IsPasswordVisible}" Padding="12,10,44,10" />
          <ToggleButton Classes="ghost" IsChecked="{Binding IsPasswordVisible}"
                        HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0">
            <Panel>
              <Border Classes="icon" Width="14" Height="14" IsVisible="{Binding !IsPasswordVisible}">
                <Border.OpacityMask>
                  <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/invisible.png" Stretch="Uniform" />
                </Border.OpacityMask>
              </Border>
              <Border Classes="icon" Width="14" Height="14" IsVisible="{Binding IsPasswordVisible}">
                <Border.OpacityMask>
                  <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/visible.png" Stretch="Uniform" />
                </Border.OpacityMask>
              </Border>
            </Panel>
          </ToggleButton>
        </Grid>
        <Grid ColumnDefinitions="*,Auto"
              IsVisible="{Binding MasterPasswordStrengthLabel, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
          <ProgressBar Grid.Column="0" Minimum="0" Maximum="100" Height="6" VerticalAlignment="Center"
                       Value="{Binding MasterPasswordStrengthValue}"
                       Foreground="{Binding MasterPasswordStrengthColor}" />
          <TextBlock Grid.Column="1" Margin="8,0,0,0" Classes="muted" FontSize="12"
                     Text="{Binding MasterPasswordStrengthLabel}" />
        </Grid>

        <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushDanger}" TextWrapping="Wrap"
                    IsVisible="{Binding ErrorMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

        <Button Classes="accent" Command="{Binding OpenExistingCommand}" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Margin="0,8,0,0">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Classes="icon" Width="14" Height="14" Background="{DynamicResource BrushOnAccent}">
              <Border.OpacityMask>
                <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/unlock.png" Stretch="Uniform" />
              </Border.OpacityMask>
            </Border>
            <TextBlock Text="Desbloquear" FontWeight="Bold" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Border>
    <TextBlock Grid.Row="1" Classes="muted" FontSize="12" HorizontalAlignment="Center" Margin="0,16,0,0"
               Text="Argon2id  ·  AES-256-GCM  ·  Sin servidor ni sincronización" />
  </Grid>
</UserControl>
