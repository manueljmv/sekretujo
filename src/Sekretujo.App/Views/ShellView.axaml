<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sekretujo.App.ViewModels"
             xmlns:views="using:Sekretujo.App.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Sekretujo.App.Views.ShellView"
             x:DataType="vm:ShellViewModel"
             x:Name="Root">
  <UserControl.Styles>
    <Style Selector="Button.entryRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="6,6" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Margin" Value="0,0,0,2" />
    </Style>
    <Style Selector="Button.entryRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource BrushSurfaceAlt}" />
    </Style>
    <Style Selector="Button.entryRow.selected">
      <Setter Property="Background" Value="{DynamicResource BrushAccentMuted}" />
    </Style>
  </UserControl.Styles>
  <Grid>
    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource BrushBackground}">

      <!-- Toolbar -->
      <Border Grid.Row="0" BorderBrush="{DynamicResource BrushBorder}" BorderThickness="0,0,0,1" Padding="16,12">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
            <Grid Width="220">
              <TextBox PlaceholderText="Buscar..." Text="{Binding SearchText}" Padding="34,10,12,10" />
              <Border Classes="icon" Background="{DynamicResource BrushTextMuted}" Margin="12,0,0,0"
                      HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border.OpacityMask>
                  <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/search.png" Stretch="Uniform" />
                </Border.OpacityMask>
              </Border>
            </Grid>

            <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="2">
              <StackPanel Orientation="Horizontal" Spacing="2">
                <ToggleButton Classes="tab" Content="Todas" Command="{Binding SetTypeFilterCommand}"
                              CommandParameter="{x:Static vm:EntryTypeFilter.All}"
                              IsChecked="{Binding TypeFilter, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:EntryTypeFilter.All}}" />
                <ToggleButton Classes="tab" Content="Contraseñas" Command="{Binding SetTypeFilterCommand}"
                              CommandParameter="{x:Static vm:EntryTypeFilter.Passwords}"
                              IsChecked="{Binding TypeFilter, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:EntryTypeFilter.Passwords}}" />
                <ToggleButton Classes="tab" Content="Notas" Command="{Binding SetTypeFilterCommand}"
                              CommandParameter="{x:Static vm:EntryTypeFilter.Notes}"
                              IsChecked="{Binding TypeFilter, Mode=OneWay, Converter={x:Static conv:ObjectConverters.Equal}, ConverterParameter={x:Static vm:EntryTypeFilter.Notes}}" />
              </StackPanel>
            </Border>

            <ToggleButton Classes="star" IsChecked="{Binding FavoritesOnly}" ToolTip.Tip="Solo favoritos">
              <Border Classes="icon" Width="14" Height="14">
                <Border.OpacityMask>
                  <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/star.png" Stretch="Uniform" />
                </Border.OpacityMask>
              </Border>
            </ToggleButton>

            <Border Background="{DynamicResource BrushSurfaceAlt}" CornerRadius="8" Padding="10,6"
                    IsVisible="{Binding AutoLockDisplay, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}">
              <TextBlock Text="{Binding AutoLockDisplay}" FontSize="12" Foreground="{DynamicResource BrushSuccess}" />
            </Border>
          </StackPanel>

          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="accent" Command="{Binding NewPasswordCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="icon" Width="14" Height="14" Background="{DynamicResource BrushOnAccent}">
                  <Border.OpacityMask>
                    <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/plus.png" Stretch="Uniform" />
                  </Border.OpacityMask>
                </Border>
                <TextBlock Text="Contraseña" />
              </StackPanel>
            </Button>
            <Button Command="{Binding NewNoteCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="icon" Width="14" Height="14">
                  <Border.OpacityMask>
                    <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/plus.png" Stretch="Uniform" />
                  </Border.OpacityMask>
                </Border>
                <TextBlock Text="Nota" />
              </StackPanel>
            </Button>
            <Button Classes="ghost" Command="{Binding OpenSettingsCommand}" ToolTip.Tip="Ajustes">
              <Border Classes="icon">
                <Border.OpacityMask>
                  <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/settings.png" Stretch="Uniform" />
                </Border.OpacityMask>
              </Border>
            </Button>
            <Button Command="{Binding LockCommand}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <Border Classes="icon" Width="14" Height="14">
                  <Border.OpacityMask>
                    <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/lock.png" Stretch="Uniform" />
                  </Border.OpacityMask>
                </Border>
                <TextBlock Text="Bloquear" />
              </StackPanel>
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <TextBlock Grid.Row="1" Margin="16,8" Foreground="{DynamicResource BrushDanger}" Text="{Binding StatusMessage}"
                 IsVisible="{Binding StatusMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

      <!-- Body -->
      <Grid Grid.Row="2" ColumnDefinitions="300,*">
        <DockPanel Grid.Column="0" Margin="12,12,6,12">
          <TextBlock DockPanel.Dock="Top" Classes="eyebrow" Margin="6,0,0,10">
            <Run Text="{Binding Entries.Count}" /><Run Text=" ENTRADAS" />
          </TextBlock>
          <ScrollViewer>
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EntryGroupViewModel">
                  <StackPanel Margin="0,0,0,14">
                    <Button Classes="entryRow" HorizontalContentAlignment="Stretch" Padding="6,4"
                            Command="{Binding ToggleExpandedCommand}">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <TextBlock Grid.Column="0" Classes="eyebrow" Text="{Binding TagName}" />
                        <Border Grid.Column="2" Classes="icon" Width="12" Height="12"
                                Background="{DynamicResource BrushTextMuted}" IsVisible="{Binding IsExpanded}">
                          <Border.OpacityMask>
                            <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/expand-arrow.png" Stretch="Uniform" />
                          </Border.OpacityMask>
                        </Border>
                        <Border Grid.Column="2" Classes="icon" Width="12" Height="12"
                                Background="{DynamicResource BrushTextMuted}" IsVisible="{Binding !IsExpanded}"
                                RenderTransform="rotate(-90deg)">
                          <Border.OpacityMask>
                            <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/expand-arrow.png" Stretch="Uniform" />
                          </Border.OpacityMask>
                        </Border>
                      </Grid>
                    </Button>
                    <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:EntryListItemViewModel">
                          <Button Classes="entryRow" Classes.selected="{Binding IsSelected}"
                                  Command="{Binding #Root.((vm:ShellViewModel)DataContext).SelectEntryCommand}"
                                  CommandParameter="{Binding}">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                              <Border Grid.Column="0" Width="34" Height="34" CornerRadius="8"
                                      Background="{DynamicResource BrushSurfaceRaised}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}" FontSize="14"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                              </Border>
                              <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                <TextBlock FontSize="12" Classes="muted">
                                  <Run Text="{Binding TypeLabel}" /><Run Text=" · " /><Run Text="{Binding Subtitle}" />
                                </TextBlock>
                              </StackPanel>
                              <Border Grid.Column="2" Classes="icon" Width="13" Height="13"
                                      Background="{DynamicResource BrushWarning}"
                                      IsVisible="{Binding IsFavorite}" VerticalAlignment="Center">
                                <Border.OpacityMask>
                                  <ImageBrush Source="avares://Sekretujo.App/Assets/Icons/star.png" Stretch="Uniform" />
                                </Border.OpacityMask>
                              </Border>
                            </Grid>
                          </Button>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
        </DockPanel>

        <ContentControl Grid.Column="1" Margin="6,12,12,12" Content="{Binding Detail}">
          <ContentControl.DataTemplates>
            <DataTemplate x:DataType="vm:EntryDetailViewModel">
              <views:EntryDetailView />
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>
    </Grid>

    <Border Background="#CC0A0A0D"
            IsVisible="{Binding SettingsOverlay, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ContentControl Content="{Binding SettingsOverlay}" HorizontalAlignment="Center" VerticalAlignment="Center">
        <ContentControl.DataTemplates>
          <DataTemplate x:DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Border>
  </Grid>
</UserControl>
